{
  "name": "antigravity-remotion-elevenlabs-studio",
  "version": "2.0.0",
  "description": "Motor programático de Shorts de resúmenes de libros (60-65s) con scraping multi-fuente, guionista Gemini y blueprints vectoriales @resultaaquee en Remotion + ElevenLabs",
  "private": true,
  "scripts": {
    "dev": "remotion studio --port 3000",
    "start": "remotion studio --port 3000",
    "build": "remotion render src/index.ts MainVideo out/video.mp4",
    "book:ingest": "node scripts/book-ingest.mjs",
    "book:script": "node scripts/book-scriptwriter.mjs",
    "book:pipeline": "node scripts/book-ingest.mjs && node scripts/book-scriptwriter.mjs && node scripts/elevenlabs-sync.mjs",
    "sync:audio": "node scripts/elevenlabs-sync.mjs",
    "qa:gate": "node scripts/promptible-gate.mjs",
    "qa:visual": "node scripts/visual-qa-gate.mjs",
    "video:reverse": "node scripts/video-reverse.mjs reverse",
    "video:describe": "node scripts/video-reverse.mjs describe",
    "video:compare": "node scripts/video-compare.mjs",
    "video:hook": "node scripts/reel-hook-analyzer.mjs",
    "session:restore": "node scripts/restore-session.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@react-three/fiber": "8.17.10",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/elevenlabs": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/media-utils": "4.0.536",
    "@remotion/motion-blur": "4.0.536",
    "@remotion/noise": "4.0.536",
    "@remotion/paths": "4.0.536",
    "@remotion/shapes": "4.0.536",
    "@remotion/tailwind-v4": "4.0.536",
    "@remotion/three": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "@types/d3-delaunay": "6.0.4",
    "@types/three": "0.170.0",
    "d3-delaunay": "6.0.4",
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "flubber": "0.4.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.536",
    "roughjs": "^4.6.6",
    "three": "0.170.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.7",
    "typescript": "^5.7.3"
  }
}
